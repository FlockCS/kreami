{
  "name": "kreami",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run verify:storage && npm run verify:heic",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/lib/database.types.ts",
    "db:types:local": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "verify:storage": "node scripts/verify-chunked-storage.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:account": "node scripts/test-account.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify:heic": "node scripts/verify-heic-sniff.ts"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.3",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.13",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "heic-to": "^1.5.2",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "typescript": "~6.0.3"
  }
}
