# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both values are safe to ship in the client bundle: the anon key is public by
# design and Row Level Security is what actually protects the data. See
# docs/09-security-moderation.md.
#
# Supabase dashboard -> Project Settings -> Data API
#
# Use the bare Project URL. The dashboard also shows a REST URL ending in
# /rest/v1 — copying that one produces requests to /rest/v1/rest/v1/... and the
# app refuses to start.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Used only by `npm run db:types` on your machine. Not read by the app.
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
